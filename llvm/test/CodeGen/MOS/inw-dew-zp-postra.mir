# RUN: llc -mtriple=mos -mcpu=mos65ce02 -run-pass=finalize-isel -verify-machineinstrs -o - %s | FileCheck %s
--- |
  @word = addrspace(1) global [2 x i8] zeroinitializer
  @boundary = addrspace(1) global i8 0

  define void @mixed() {
  entry:
    ret void
  }

  define void @boundary_inc() {
  entry:
    ret void
  }

  define void @final_imag_inc_with_live_z() {
  entry:
    ret void
  }

  define void @final_imag_dec_with_live_z() {
  entry:
    ret void
  }

  define void @negative_offset() {
  entry:
    ret void
  }
...
---
name: mixed
tracksRegLiveness: true
body: |
  bb.0.entry:
    liveins: $rc2, $rc3
    ; CHECK-LABEL: name: mixed
    ; CHECK: INW_ZeroPage @word, implicit-def $z
    ; CHECK: $rs1 = INWImag $rs1
    $rc2, $rc3 = IncMB @word, @word + 1, $rc2, $rc3, implicit-def $c, implicit-def $v
    RTS implicit $rc2, implicit $rc3
...
---
name: boundary_inc
tracksRegLiveness: true
body: |
  bb.0.entry:
    ; The pair extends beyond @boundary.
    ; CHECK-LABEL: name: boundary_inc
    ; CHECK-NOT: INW_ZeroPage
    ; CHECK: INCAbs @boundary + 255, implicit-def $z
    IncMB @boundary + 255, @boundary + 256, implicit-def $c, implicit-def $v
    RTS
...
---
# A live Z does not block the word op: INW sets Z from the 16-bit result, and
# the INC/BNE/INC chain it replaces leaves exactly the same value behind -- the
# branch is not taken only when the low byte wrapped to zero, so the surviving
# Z is (word == 0) either way. N does differ, but IncMB does not define it.
name: final_imag_inc_with_live_z
tracksRegLiveness: true
body: |
  bb.0.entry:
    successors: %bb.1
    liveins: $rc2, $rc3
    ; CHECK-LABEL: name: final_imag_inc_with_live_z
    ; CHECK: $rs1 = INWImag $rs1, implicit-def $z
    $rc2, $rc3 = IncMB $rc2, $rc3, implicit-def $c, implicit-def $v, implicit-def $z
    BR %bb.1, $z, -1

  bb.1:
    liveins: $z
    RTS
...
---
# DEW does block on a promised Z. The chain it replaces ends in DEC, whose Z
# reports the borrow out of the high byte, not a zero word.
name: final_imag_dec_with_live_z
tracksRegLiveness: true
body: |
  bb.0.entry:
    successors: %bb.1
    liveins: $rc2, $rc3
    ; CHECK-LABEL: name: final_imag_dec_with_live_z
    ; CHECK-NOT: DEWImag
    $a, $rc2, $rc3 = DecMB $rc2, $rc3, implicit-def $c, implicit-def $v, implicit-def $z
    BR %bb.1, $z, -1

  bb.1:
    liveins: $z
    RTS
...
---
name: negative_offset
tracksRegLiveness: true
body: |
  bb.0.entry:
    ; CHECK-LABEL: name: negative_offset
    ; CHECK-NOT: INW_ZeroPage
    ; CHECK: INCAbs @word - 1, implicit-def $z
    IncMB @word - 1, @word, implicit-def $c, implicit-def $v
    RTS
...
