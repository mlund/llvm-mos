# RUN: llc -mtriple=mos -start-before=greedy -filetype=obj %s -o %t.o
# RUN: llvm-readelf -r -s %t.o | FileCheck %s

# CHECK-LABEL: Relocation section '.rela.mos.imag32'
# CHECK: R_MOS_ADDR8
# CHECK-SAME: __mos_imag32_contiguous
# CHECK: GLOBAL DEFAULT UND __mos_imag32_contiguous

--- |
  target triple = "mos"

  define void @store() {
    unreachable
  }
...
---
name: store
stack:
  - { id: 0, size: 4 }
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $rl1
    early-clobber $rs2 = STStk $rl1, %stack.0, 0 :: (store (s32) into %stack.0)
    RTS
...
